{
  "name": "hated-wow-mcp",
  "version": "0.2.0",
  "description": "Hated WoW MCP — an MCP server for World of Warcraft addon development: the in-game Lua API, Blizzard's shipped UI source, and game art/file data.",
  "author": "Hated Gaming",
  "type": "module",
  "bin": {
    "hated-wow-mcp": "dist/index.js",
    "hated-wow-mcp-sync": "dist/sync/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RdyGaming/hated-wow-mcp.git"
  },
  "homepage": "https://github.com/RdyGaming/hated-wow-mcp#readme",
  "bugs": {
    "url": "https://github.com/RdyGaming/hated-wow-mcp/issues"
  },
  "funding": "https://buymeacoffee.com/rdygaming",
  "main": "dist/index.js",
  "files": [
    "dist",
    "data/api-*.json",
    "data/ui.xsd",
    "data/manifest.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "list-tools": "node dist/index.js --list",
    "sync-api": "tsx src/sync/api.ts",
    "sync-ui-source": "tsx src/sync/ui-source.ts",
    "sync-game-data": "tsx src/sync/game-data.ts",
    "sync-all": "npm run sync-api && npm run sync-ui-source && npm run sync-game-data",
    "web": "node server.js",
    "test": "node test/smoke.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "world-of-warcraft",
    "wow",
    "addon",
    "lua",
    "blizzard",
    "battle.net"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^4.5.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

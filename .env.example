# All settings are optional. With none of them set, the server works against
# the bundled data and defaults to retail.

# --- Game client --------------------------------------------------------------
# Which client tools answer for when a tool call does not name one explicitly.
# mainline | mists | cata | wrath | tbc | vanilla
WOW_DEFAULT_FLAVOR=mainline

# --- Local installation -------------------------------------------------------
# Path to the folder that contains _retail_ / _classic_era_ / _classic_.
# Leave unset to auto-detect the standard install locations.
# Windows example: C:\Program Files (x86)\World of Warcraft
# macOS example:   /Applications/World of Warcraft
WOW_INSTALL_PATH=

# Path to the AddOns folder the file tools read and write. Defaults to the
# AddOns folder of the detected install. When set, addon tools accept relative
# paths and refuse to read or write outside this directory.
# WOW_ADDON_PATH=C:\Program Files (x86)\World of Warcraft\_retail_\Interface\AddOns
WOW_ADDON_PATH=
